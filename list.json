{
  "tools": [
    {
      "name": "ocr",
      "description": "Perform OCR (Optical Character Recognition) on the provided image to extract text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "png_fix": {
            "type": "boolean",
            "default": false
          },
          "probability": {
            "type": "boolean",
            "default": false
          },
          "charset_range": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "color_filter": {},
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "custom_color_ranges": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "color_filter_colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "color_filter_custom_ranges": {
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "image": {
            "type": "string",
            "description": "Base64 encoded image or data URI."
          }
        },
        "required": [
          "image"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "result",
          "processing_time"
        ],
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "text",
                  "probabilities",
                  "charset",
                  "confidence"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "probabilities": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "charset": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "confidence": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "processing_time": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "det",
      "description": "Perform object detection on the provided image to find bounding boxes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "description": "The image to detect objects in, base64 encoded."
          }
        },
        "required": [
          "image"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "result",
          "processing_time"
        ],
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "description": "List of bounding boxes [[x1, y1, x2, y2], ...]."
          },
          "processing_time": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "slide_match",
      "description": "Match the slider (target) image to the background image for captcha solving.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_image": {
            "type": "string",
            "description": "The slider image, base64 encoded."
          },
          "background_image": {
            "type": "string",
            "description": "The background image, base64 encoded."
          },
          "simple_target": {
            "type": "boolean",
            "description": "Whether it is a simple slider."
          }
        },
        "required": [
          "target_image",
          "background_image"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "result",
          "processing_time"
        ],
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "target": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "Target position [x1, y1, x2, y2]."
              },
              "target_x": {
                "type": "integer",
                "description": "X offset of the transparent part."
              },
              "target_y": {
                "type": "integer",
                "description": "Y offset of the transparent part."
              }
            },
            "required": [
              "target",
              "target_x",
              "target_y"
            ]
          },
          "processing_time": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "slide_comparison",
      "description": "Compare the slider and background to find the gap position.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_image": {
            "type": "string",
            "description": "The slider image, base64 encoded."
          },
          "background_image": {
            "type": "string",
            "description": "The background image, base64 encoded."
          }
        },
        "required": [
          "target_image",
          "background_image"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "result",
          "processing_time"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "processing_time": {
            "type": "number"
          }
        }
      }
    }
  ]
}
